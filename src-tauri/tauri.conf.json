{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "IRIS Desktop",
  "version": "0.2.0",
  "identifier": "ai.solstice.iris",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "IRIS",
        "label": "main",
        "width": 1000,
        "height": 600,
        "minWidth": 300,
        "minHeight": 160,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": true,
        "skipTaskbar": true,
        "x": 100,
        "y": 100,
        "backgroundColor": [
          0,
          0,
          0,
          0
        ],
        "shadow": false
      },
      {
        "title": "IRIS Canvas",
        "label": "canvas",
        "width": 850,
        "height": 900,
        "minWidth": 400,
        "minHeight": 300,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "visible": false,
        "skipTaskbar": false,
        "backgroundColor": [
          2,
          6,
          23,
          255
        ],
        "shadow": true,
        "x": 20,
        "y": 80
      },
      {
        "title": "IRIS Annotation",
        "label": "annotation",
        "url": "/",
        "width": 1920,
        "height": 1080,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true,
        "x": 0,
        "y": 0,
        "backgroundColor": [
          0,
          0,
          0,
          0
        ],
        "shadow": false
      },
      {
        "title": "Grid Calibrator",
        "label": "grid-calibrator",
        "url": "/",
        "width": 1920,
        "height": 1080,
        "resizable": true,
        "fullscreen": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": false,
        "backgroundColor": [
          0,
          0,
          0,
          0
        ],
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; base-uri 'none'; object-src 'none'; frame-src 'self'; form-action 'none'; script-src 'self'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' blob: mediastream:; connect-src 'self' ipc: http://ipc.localhost https://storage.googleapis.com"
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  },
  "plugins": {}
}
