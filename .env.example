# Optional source-build fallback. In-app Reasoning Provider settings are
# preferred on Windows because credentials are stored in the OS vault.
# Values: mock, gemini, openai, openai-compatible, custom.
IRIS_MODEL_PROVIDER=mock

# For Gemini/OpenAI presets, the native runtime owns the fixed API origin.
# IRIS_BASE_URL is used only for openai-compatible/custom providers.
# Never commit a real credential.
IRIS_API_KEY=
IRIS_BASE_URL=https://example.com/v1
IRIS_MODEL=your-model
GEMINI_API_KEY=

# Optional voice providers. Prefer configuring these in the Windows app so
# credentials are stored in Windows Credential Manager. Never commit real keys.
IRIS_OPENAI_API_KEY=
IRIS_ELEVENLABS_API_KEY=
